<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_delivery_document_inherit_carrier" inherit_id="stock.report_delivery_document" priority="50">
        <!-- Fix overlap by adding a spacer after the informations block -->
        <xpath expr="//div[@id='informations']" position="after">
            <div style="height: 30px; clear: both;"/>
        </xpath>

        <!-- Inject Transportista field into the right column of the informations block -->
        <!-- Targeting the second col-6 which contains Order, PO, etc. -->
        <xpath expr="//div[@id='informations']/div[2]" position="inside">
            <t t-if="o.carrier_id">
                <br/>
                <strong>Transportista:</strong>
                <span t-field="o.carrier_id.name"/>
            </t>
        </xpath>
    </template>
</odoo>
