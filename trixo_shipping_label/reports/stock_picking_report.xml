<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Combined Fix: Table Spacing + Transportista Field -->
    <template id="report_delivery_document_inherit_final" inherit_id="stock.report_delivery_document" priority="100">

        <!-- CSS to fix table overlap and compactness -->
        <!-- CSS to fix table overlap and compactness -->
        <xpath expr="//div[@class='page']" position="before">
            <style>
                /* Force Table to be clear of floats and add margin */ table[name='stock_move_line_table'], table[name='stock_move_table'] {
                    margin-top: 50px !important;
                    clear: both !important;
                }
                /* Compact table rows for product details */
                table.table td, table.table th { 
                    padding-top: 2px !important; 
                    padding-bottom: 2px !important; 
                    line-height: 1.2 !important;
                }
            </style>
        </xpath>

        <!-- "Transportista" Field: Injected BEFORE the FIRST table (stock_move_table).
             This avoids breaking the t-if/t-elif chain between stock_move_table and stock_move_line_table.
        -->
        <xpath expr="//table[@name='stock_move_table']" position="before">
            <div class="row" style="margin-bottom: 20px; padding-left: 15px;">
                <div class="col-12">
                    <strong>Transportista: </strong>
                    <span t-if="o.carrier_id" t-field="o.carrier_id.name"/>
                    <span t-else="">(Sin asignar)</span>
                </div>
            </div>
        </xpath>

    </template>
</odoo>
