<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_delivery_document_inherit_carrier" inherit_id="stock.report_delivery_document" priority="99">
        <!-- Inject AFTER the information block, but pull it up visually to merge with the header -->
        <xpath expr="//div[@id='informations']" position="after">
            <div class="row" style="margin-top: -20px;">
                <div class="col-6">
                    <!-- Spacer for left column -->
                </div>
                <!-- Right column aligned with the header's right column -->
                <div class="col-6">
                    <strong>Transportista:</strong>
                    <t t-if="o.carrier_id">
                        <span t-field="o.carrier_id.name"/>
                    </t>
                    <t t-else="">
                        <span>(Sin asignar)</span>
                    </t>
                </div>
            </div>
        </xpath>
    </template>
</odoo>
