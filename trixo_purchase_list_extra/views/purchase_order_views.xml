<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Compras > Ordenes > Solicitudes de cotizacion (vista con los KPIs) -->
    <record id="purchase_order_kpis_tree_inherit_trx_extra" model="ir.ui.view">
        <field name="name">purchase.order.kpis.list.inherit.trx.extra</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_kpis_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="create_date" string="Creado el" optional="show" readonly="1"/>
            </xpath>
            <xpath expr="//field[@name='state']" position="after">
                <field name="trx_receipt_state" optional="show" widget="badge"
                       decoration-success="trx_receipt_state == 'done'"
                       decoration-danger="trx_receipt_state != 'done'"/>
            </xpath>
        </field>
    </record>

    <!-- Compras > Ordenes > Ordenes de compra -->
    <record id="purchase_order_view_tree_inherit_trx_extra" model="ir.ui.view">
        <field name="name">purchase.order.list.inherit.trx.extra</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_view_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="create_date" string="Creado el" optional="show" readonly="1"/>
            </xpath>
            <!-- En esta vista 'state' es column_invisible, se ancla en la
                 columna visible de estado de facturacion -->
            <xpath expr="//field[@name='invoice_status']" position="after">
                <field name="trx_receipt_state" optional="show" widget="badge"
                       decoration-success="trx_receipt_state == 'done'"
                       decoration-danger="trx_receipt_state != 'done'"/>
            </xpath>
        </field>
    </record>

</odoo>
