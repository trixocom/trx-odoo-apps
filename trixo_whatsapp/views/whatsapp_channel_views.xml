<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Smart button en el cliente: ver todos sus chats de WhatsApp -->
    <record id="view_partner_form_whatsapp" model="ir.ui.view">
        <field name="name">res.partner.form.whatsapp</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button class="oe_stat_button" type="object"
                        name="action_open_whatsapp_channels" icon="fa-whatsapp"
                        invisible="whatsapp_channel_count == 0">
                    <field name="whatsapp_channel_count" widget="statinfo"
                           string="Chats WhatsApp"/>
                </button>
            </div>
        </field>
    </record>

    <!-- Conversaciones WhatsApp -->
    <record id="view_whatsapp_channel_list" model="ir.ui.view">
        <field name="name">whatsapp.channel.list</field>
        <field name="model">discuss.channel</field>
        <field name="arch" type="xml">
            <list create="false">
                <field name="name"/>
                <field name="whatsapp_is_group" string="Grupo"/>
                <field name="whatsapp_partner_id"/>
                <field name="whatsapp_number"/>
                <field name="wa_account_id"/>
                <field name="write_date" string="Última actividad"/>
            </list>
        </field>
    </record>

    <record id="view_whatsapp_channel_form" model="ir.ui.view">
        <field name="name">whatsapp.channel.form</field>
        <field name="model">discuss.channel</field>
        <field name="arch" type="xml">
            <form create="false">
                <header>
                    <button name="action_open_whatsapp_partner" type="object"
                            string="Ir al cliente" class="btn-primary"
                            invisible="not whatsapp_partner_id"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Grupo" bg_color="text-bg-info"
                            invisible="not whatsapp_is_group"/>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="whatsapp_number" readonly="1"/>
                            <field name="wa_account_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="whatsapp_is_group" readonly="1"/>
                            <field name="whatsapp_partner_id"
                                   help="Asociá este chat a un cliente o proveedor"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_whatsapp_channel" model="ir.actions.act_window">
        <field name="name">Conversaciones</field>
        <field name="res_model">discuss.channel</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('wa_account_id', '!=', False)]</field>
        <field name="context">{'create': False}</field>
    </record>
</odoo>
