<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_whatsapp_account_form" model="ir.ui.view">
        <field name="name">whatsapp.account.form</field>
        <field name="model">whatsapp.account</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="button_test_connection" type="object"
                            string="Probar conexión" class="btn-primary"/>
                    <button name="action_connect_whatsmeow" type="object"
                            string="Conectar / QR" class="btn-secondary"
                            invisible="provider != 'whatsmeow'"/>
                    <button name="action_refresh_qr" type="object"
                            string="Refrescar QR"
                            invisible="provider != 'whatsmeow'"/>
                    <button name="action_logout_whatsmeow" type="object"
                            string="Cerrar sesión"
                            invisible="provider != 'whatsmeow'"/>
                    <field name="whatsmeow_state" widget="badge"
                           invisible="provider != 'whatsmeow'"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Nombre de la cuenta"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="provider"/>
                            <field name="phone_number"/>
                            <field name="callback_url" widget="CopyClipboardChar"/>
                        </group>
                        <group>
                            <field name="notify_user_ids" widget="many2many_tags"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Meta Cloud API"
                              invisible="provider != 'meta_cloud'">
                            <group>
                                <field name="meta_app_uid"/>
                                <field name="meta_app_secret" password="True"/>
                                <field name="meta_account_uid"/>
                                <field name="meta_phone_uid"/>
                                <field name="meta_token" password="True"/>
                                <field name="meta_webhook_verify_token"/>
                            </group>
                        </page>
                        <page string="whatsmeow (sidecar)"
                              invisible="provider != 'whatsmeow'">
                            <group>
                                <field name="whatsmeow_base_url"
                                       placeholder="http://whatsmeow:8080"/>
                                <field name="whatsmeow_token" password="True"/>
                                <field name="whatsmeow_session_id"/>
                            </group>
                            <group string="QR de vinculación"
                                   invisible="whatsmeow_state != 'qr_pending'">
                                <field name="whatsmeow_qr" widget="image"
                                       nolabel="1" options="{'size': [220, 220]}"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_whatsapp_account_list" model="ir.ui.view">
        <field name="name">whatsapp.account.list</field>
        <field name="model">whatsapp.account</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="provider"/>
                <field name="phone_number"/>
                <field name="whatsmeow_state"/>
            </list>
        </field>
    </record>

    <record id="action_whatsapp_account" model="ir.actions.act_window">
        <field name="name">Cuentas WhatsApp</field>
        <field name="res_model">whatsapp.account</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
