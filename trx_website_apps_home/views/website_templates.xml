<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        En el frontend del sitio web, el boton de apps (grilla, arriba a la
        izquierda) abre un menu desplegable con la lista de aplicaciones.
        Aca cambiamos ese comportamiento: el boton lleva directamente al home
        del backend (/odoo), o sea la pantalla con los iconos de las apps, en
        lugar de desplegar el menu. Cambio aditivo y reversible: solo hereda
        website.layout, no toca core.
    -->
    <template id="frontend_apps_btn_to_home" inherit_id="website.layout"
              name="TRX Website: boton apps abre el home de iconos">
        <!-- El boton navega al home de apps en vez de togglear el dropdown -->
        <xpath expr="//a[hasclass('o_frontend_to_backend_apps_btn')]" position="attributes">
            <attribute name="href">/odoo</attribute>
            <attribute name="data-bs-toggle"/>
        </xpath>
        <!-- Quitamos el menu desplegable que ya no se usa -->
        <xpath expr="//div[hasclass('o_frontend_to_backend_apps_menu')]" position="replace"/>
    </template>
</odoo>
