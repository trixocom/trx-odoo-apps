<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_partner_form_trixo_deudores" model="ir.ui.view">
        <field name="name">res.partner.form.trixo.deudores</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='sales_purchases']//group[@name='misc']" position="inside">
                <field name="trixo_excluir_deudores"
                       groups="trixo_aged_receivable.group_trixo_deudores"/>
            </xpath>
        </field>
    </record>

    <record id="view_partner_list_trixo_excluidos" model="ir.ui.view">
        <field name="name">res.partner.list.trixo.excluidos</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <list string="Contactos excluidos del tablero" editable="bottom" create="0" delete="0">
                <field name="ref" string="Codigo" readonly="1"/>
                <field name="name" readonly="1"/>
                <field name="trixo_excluir_deudores" string="Excluido"/>
            </list>
        </field>
    </record>

    <record id="action_trixo_partner_excluidos" model="ir.actions.act_window">
        <field name="name">Contactos excluidos</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_partner_list_trixo_excluidos"/>
        <field name="domain">[('trixo_excluir_deudores', '=', True)]</field>
        <field name="context">{'active_test': False}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Ningun contacto esta excluido</p>
            <p>Los contactos marcados aca no se cuentan en el tablero de Deudores.
               Para excluir uno nuevo, abri su ficha y tilda
               "Excluir del tablero de Deudores" en la pestana Ventas y compras.</p>
        </field>
    </record>

</odoo>
