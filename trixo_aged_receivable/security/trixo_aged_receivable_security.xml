<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <record id="res_groups_privilege_deudores" model="res.groups.privilege">
            <field name="name">Deudores</field>
            <field name="category_id" ref="base.module_category_accounting"/>
            <field name="sequence">40</field>
        </record>

        <record id="group_trixo_deudores" model="res.groups">
            <field name="name">Tablero de Deudores</field>
            <field name="privilege_id" ref="res_groups_privilege_deudores"/>
            <field name="comment">Acceso al menu Deudores: cuentas por cobrar por cliente y antiguedad de saldos.</field>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="trixo_receivable_line_company_rule" model="ir.rule">
            <field name="name">Deudores detalle: multi-compania</field>
            <field name="model_id" ref="model_trixo_receivable_line"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="global" eval="True"/>
        </record>

        <record id="trixo_receivable_partner_company_rule" model="ir.rule">
            <field name="name">Deudores resumen: multi-compania</field>
            <field name="model_id" ref="model_trixo_receivable_partner"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="global" eval="True"/>
        </record>

    </data>
</odoo>
