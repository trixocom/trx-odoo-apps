<odoo>

    <!-- Formulario de plantilla de producto (caso variante única) -->
    <record id="view_product_template_form_generate_ean13" model="ir.ui.view">
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view" />
        <field name="arch" type="xml">
            <field name="barcode" position="after">
                <button
                    name="action_generate_ean13"
                    type="object"
                    string="Generar Código"
                    class="btn-link"
                    invisible="barcode or product_variant_count &gt; 1"
                />
            </field>
        </field>
    </record>

    <!-- Formulario de variante de producto -->
    <record id="view_product_product_form_generate_ean13" model="ir.ui.view">
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_normal_form_view" />
        <field name="arch" type="xml">
            <field name="barcode" position="after">
                <button
                    name="action_generate_ean13"
                    type="object"
                    string="Generar Código"
                    class="btn-link"
                    invisible="barcode"
                />
            </field>
        </field>
    </record>

</odoo>
