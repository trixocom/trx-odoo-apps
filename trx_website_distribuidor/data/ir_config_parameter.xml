<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- Destinos de WhatsApp separados por coma: número (549...) o JID de grupo (...@g.us) -->
    <record id="param_wa_destinos" model="ir.config_parameter">
        <field name="key">trx_website_distribuidor.wa_destinos</field>
        <field name="value"> </field>
    </record>
    <!-- False = no manda WhatsApp (solo deja constancia en el pedido). Usar en entornos de prueba. -->
    <record id="param_wa_activo" model="ir.config_parameter">
        <field name="key">trx_website_distribuidor.wa_activo</field>
        <field name="value">False</field>
    </record>
    <!-- True = avisa cualquier pedido web; False = solo los de distribuidores -->
    <record id="param_avisar_todos" model="ir.config_parameter">
        <field name="key">trx_website_distribuidor.avisar_todos_web</field>
        <field name="value">False</field>
    </record>
</odoo>
