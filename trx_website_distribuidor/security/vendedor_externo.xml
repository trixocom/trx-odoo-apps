<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="group_vendedor_externo" model="res.groups">
        <field name="name">Vendedor externo</field>
        <field name="comment">Usuario interno que solo ve los clientes que creó o que tiene asignados como vendedor, y solo sus pedidos y facturas.</field>
    </record>

    <!-- Reglas GLOBALES condicionales: para cualquier usuario que no esté en
         "Vendedor externo" el dominio es [(1,'=',1)] (no cambia nada). Tienen
         que ser globales porque las reglas de grupo se combinan con OR y no
         podrían achicar lo que ya da "Ventas: solo sus documentos". -->
    <record id="rule_vendedor_externo_partner" model="ir.rule">
        <field name="name">Vendedor externo: solo sus clientes</field>
        <field name="model_id" ref="base.model_res_partner"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[(1, '=', 1)] if not user.has_group('trx_website_distribuidor.group_vendedor_externo') else ['|', '|', '|', '|', '|', ('user_id', '=', user.id), ('create_uid', '=', user.id), ('commercial_partner_id.user_id', '=', user.id), ('commercial_partner_id.create_uid', '=', user.id), ('user_ids.share', '=', False), ('id', 'in', user.company_ids.partner_id.ids)]</field>
    </record>
    <record id="rule_vendedor_externo_sale_order" model="ir.rule">
        <field name="name">Vendedor externo: solo sus pedidos</field>
        <field name="model_id" ref="sale.model_sale_order"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[(1, '=', 1)] if not user.has_group('trx_website_distribuidor.group_vendedor_externo') else ['|', ('user_id', '=', user.id), ('create_uid', '=', user.id)]</field>
    </record>
    <record id="rule_vendedor_externo_sale_order_line" model="ir.rule">
        <field name="name">Vendedor externo: solo las líneas de sus pedidos</field>
        <field name="model_id" ref="sale.model_sale_order_line"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[(1, '=', 1)] if not user.has_group('trx_website_distribuidor.group_vendedor_externo') else ['|', ('order_id.user_id', '=', user.id), ('order_id.create_uid', '=', user.id)]</field>
    </record>
    <record id="rule_vendedor_externo_account_move" model="ir.rule">
        <field name="name">Vendedor externo: solo sus facturas de venta</field>
        <field name="model_id" ref="account.model_account_move"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[(1, '=', 1)] if not user.has_group('trx_website_distribuidor.group_vendedor_externo') else ['&amp;', ('move_type', 'in', ('out_invoice', 'out_refund')), '|', ('invoice_user_id', '=', user.id), ('create_uid', '=', user.id)]</field>
    </record>
</odoo>
