<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="trx_login_as_user_view_form" model="ir.ui.view">
        <field name="name">trx.login.as.user.form</field>
        <field name="model">trx.login.as.user</field>
        <field name="arch" type="xml">
            <form string="Iniciar sesion como otro usuario">
                <div class="alert alert-warning" role="alert">
                    Va a seguir trabajando con los permisos de ese usuario hasta
                    que vuelva a su sesion con el mismo icono de la barra superior.
                    La accion queda registrada en el log del servidor.
                </div>
                <group>
                    <field name="user_id" options="{'no_create': True, 'no_open': True}"/>
                </group>
                <group string="Permisos del usuario" invisible="not user_id">
                    <field name="group_ids" nolabel="1" readonly="1"
                           widget="many2many_tags"/>
                </group>
                <footer>
                    <button name="action_switch" string="Iniciar sesion"
                            type="object" class="btn-primary"/>
                    <button string="Cancelar" special="cancel"
                            class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="trx_login_as_user_action" model="ir.actions.act_window">
        <field name="name">Iniciar sesion como otro usuario</field>
        <field name="res_model">trx.login.as.user</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="groups_id" eval="[(4, ref('trx_login_as_user.group_login_as_user'))]"/>
    </record>
</odoo>
