<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="mrp_bom_form_view_inherit_alezlabs" model="ir.ui.view">
        <field name="name">mrp.bom.form.inherit.alezlabs</field>
        <field name="model">mrp.bom</field>
        <field name="inherit_id" ref="mrp.mrp_bom_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='bom_line_ids']/tree/field[@name='product_qty']" position="after">
                <field name="x_phase"/>
            </xpath>
            <xpath expr="//field[@name='bom_line_ids']/form/group" position="inside">
                <field name="x_phase"/>
            </xpath>
        </field>
    </record>
</odoo>
