<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Product Template Form View Inherit -->
    <record id="product_template_form_view_inherit_alezlabs" model="ir.ui.view">
        <field name="name">product.template.form.inherit.alezlabs</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <div name="options" position="inside">
                <span class="d-inline-block">
                    <field name="x_formula_type"/>
                    <label for="x_formula_type"/>
                </span>
            </div>
            <group name="group_general" position="after">
                <group string="Datos de Fórmula" name="formula_data">
                    <group>
                        <field name="x_formula_version"/>
                        <field name="x_min_manufacture_qty"/>
                    </group>
                    <group>
                        <field name="x_elaboration_method"/>
                        <field name="x_shrinkage"/>
                    </group>
                </group>
            </group>
        </field>
    </record>
</odoo>
