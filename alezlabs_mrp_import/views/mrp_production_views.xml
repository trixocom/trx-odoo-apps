<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="mrp_production_form_view_inherit_alezlabs" model="ir.ui.view">
        <field name="name">mrp.production.form.inherit.alezlabs</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_form_view"/>
        <field name="arch" type="xml">
            <group name="group_extra_info" position="before">
                <group string="Datos de Fórmula">
                    <group>
                        <field name="x_formula_version"/>
                        <field name="x_formula_type"/>
                        <field name="x_min_manufacture_qty"/>
                    </group>
                    <group>
                        <field name="x_elaboration_method"/>
                        <field name="x_shrinkage"/>
                    </group>
                </group>
            </group>

            <!-- Add Phase to Components Tab (Stock Moves) -->
            <xpath expr="//field[@name='move_raw_ids']/tree/field[@name='product_uom_qty']" position="after">
                <field name="x_phase" optional="show"/>
            </xpath>
        </field>
    </record>
</odoo>
