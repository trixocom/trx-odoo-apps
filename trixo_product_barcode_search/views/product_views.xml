<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_search_view_barcode_default" model="ir.ui.view">
        <field name="name">product.template.search.barcode.default</field>
        <field name="model">product.template</field>
        <field name="priority" eval="999"/>
        <field name="inherit_id" ref="product.product_template_search_view"/>
        <field name="arch" type="xml">
            <!-- Usamos name='barcode' en vez de 'name' para que otros módulos que inyectan ANTES de 'name' no nos pisen la primera posición -->
            <xpath expr="//search/field[1]" position="before">
                <field name="barcode" string="Búsqueda Automática (Nombre/Ref/Barras)" filter_domain="['|', '|', '|', ('default_code', 'ilike', self), ('product_variant_ids.default_code', 'ilike', self), ('name', 'ilike', self), ('barcode', 'ilike', self)]"/>
            </xpath>
        </field>
    </record>

    <record id="product_product_search_view_barcode_default" model="ir.ui.view">
        <field name="name">product.product.search.barcode.default</field>
        <field name="model">product.product</field>
        <field name="priority" eval="999"/>
        <field name="inherit_id" ref="product.product_search_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//search/field[1]" position="before">
                <field name="barcode" string="Búsqueda Automática (Nombre/Ref/Barras)" filter_domain="['|', '|', ('default_code', 'ilike', self), ('name', 'ilike', self), ('barcode', 'ilike', self)]"/>
            </xpath>
        </field>
    </record>
</odoo>
