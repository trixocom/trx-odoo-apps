<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Odoo 19: la UoM de la linea ES el embalaje (Bulto x N) y la columna
         Cantidad es la cantidad de bultos. Columnas de paridad con v18:
         Embalaje / Cant Emb. (derivadas tambien para lineas en unidades de
         pedidos migrados) y Unidades. Total Bultos grande en el titulo.

         v19.0.2.2.1: los xpath apuntan explicitamente a /list/. Con el
         selector descendiente (//) el primer nodo que matchea es el del
         <form> embebido de la linea (que en el arch de sale.view_order_form
         de 19 viene ANTES del <list>), por lo que las columnas se insertaban
         en el formulario de linea y NUNCA se veian en la grilla. Verificado
         sobre el arch combinado: //field[@name='order_line']/list/field[
         @name='product_uom_qty'] devuelve 1 nodo. -->
    <record id="view_order_form_inherit_default_packaging" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.default.packaging</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <!-- Total Bultos grande en el encabezado -->
            <xpath expr="//div[hasclass('oe_title')]" position="inside">
                <div class="mt-2 text-primary" style="font-size: 1.6rem; font-weight: bold;">
                    <span>Total Bultos: </span>
                    <field name="total_bultos" readonly="1" class="oe_inline"/>
                </div>
            </xpath>
            <!-- GRILLA: columnas Embalaje / Cant Emb. antes de la cantidad -->
            <xpath expr="//field[@name='order_line']/list/field[@name='product_uom_qty']" position="before">
                <field name="trixo_pkg_uom_name" string="Embalaje" optional="show" readonly="1"/>
                <field name="trixo_pkg_qty" string="Cant Emb." optional="show" readonly="1"/>
            </xpath>
            <!-- GRILLA: columna Unidades (readonly) despues de la cantidad -->
            <xpath expr="//field[@name='order_line']/list/field[@name='product_uom_qty']" position="after">
                <field name="trixo_units_qty" string="Unidades" optional="show" readonly="1"/>
            </xpath>
        </field>
    </record>
</odoo>
