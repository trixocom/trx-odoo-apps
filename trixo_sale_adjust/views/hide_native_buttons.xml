<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Camino unico: las devoluciones y notas de credito de un pedido de venta
         se hacen desde "Ajustar pedido". Los dos botones nativos que compiten
         con ese camino quedan reservados al grupo
         "Ver Devolver y Nota de credito nativos", que por defecto no tiene
         nadie: para devolverselos a un usuario alcanza con tildarle el grupo.

         Como `groups` no admite condiciones, el boton original se esconde
         (solo en documentos de venta) y se agrega un gemelo, con el mismo
         destino, visible unicamente para el grupo.

         priority=99: se aplican despues de sale_stock, purchase_stock y de
         cualquier otro modulo que reescriba el "invisible" del boton Devolver.

         No se tocan: devoluciones a proveedor (recepciones de compra) ni
         notas de credito de facturas de proveedor. -->

    <record id="view_picking_form_trixo_adjust_hide_return" model="ir.ui.view">
        <field name="name">stock.picking.form.trixo.adjust.hide.return</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='%(stock.act_stock_return_picking)d']" position="attributes">
                <attribute name="invisible" separator="or" add="sale_id"/>
            </xpath>
            <xpath expr="//button[@name='%(stock.act_stock_return_picking)d']" position="after">
                <button name="%(stock.act_stock_return_picking)d" string="Devolver" type="action"
                        groups="trixo_sale_adjust.group_native_return_refund"
                        invisible="state != 'done' or not sale_id"/>
            </xpath>
        </field>
    </record>

    <record id="view_move_form_trixo_adjust_hide_credit_note" model="ir.ui.view">
        <field name="name">account.move.form.trixo.adjust.hide.credit.note</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_reverse']" position="attributes">
                <attribute name="invisible" separator="or" add="move_type == 'out_invoice'"/>
            </xpath>
            <xpath expr="//button[@name='action_reverse']" position="after">
                <button name="action_reverse" string="Nota de credito" type="object"
                        groups="trixo_sale_adjust.group_native_return_refund"
                        invisible="move_type != 'out_invoice' or state != 'posted'"/>
            </xpath>
        </field>
    </record>
</odoo>
