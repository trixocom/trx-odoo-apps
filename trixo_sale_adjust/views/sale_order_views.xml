<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_order_form_trixo_adjust" model="ir.ui.view">
        <field name="name">sale.order.form.trixo.adjust</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <!-- Boton de cabecera -->
            <xpath expr="//header" position="inside">
                <button name="action_open_trixo_adjust" type="object" string="Ajustar pedido"
                        groups="trixo_sale_adjust.group_sale_adjust"
                        invisible="state != 'sale' or locked"
                        help="Unico camino para cambiar un pedido ya facturado: devolver, cambiar de embalaje o agregar productos. Genera la devolucion, la nota de credito y la factura que correspondan."/>
            </xpath>
            <!-- Boton por linea, al lado de lo entregado (paridad v18 sale_stock_ux) -->
            <xpath expr="//field[@name='order_line']/list//field[@name='qty_delivered']" position="after">
                <field name="qty_to_deliver" column_invisible="1"/>
                <button name="action_trixo_cancel_remaining" type="object" icon="fa-ban"
                        title="Cancelar cantidades pendientes de entregar"
                        groups="trixo_sale_adjust.group_sale_adjust"
                        invisible="parent.state != 'sale' or parent.locked or display_type or qty_to_deliver &lt;= 0"
                        help="Deja la linea en lo ya entregado y cancela los movimientos pendientes. Si hay facturado de mas, abre el ajuste del pedido para emitir la nota de credito."/>
            </xpath>
        </field>
    </record>

    <!-- 19.0.1.5.0 / 19.0.1.5.1: en un pedido confirmado y con factura de
         cliente vigente las lineas no se editan desde el formulario
         (decisiones de Tito 22-09-2026). Todo cambio pasa por "Ajustar
         pedido". Antes de facturar se editan como siempre. El control del lado servidor esta en
         sale.order.write; esta vista solo evita que el usuario lo intente.
         priority 99: se aplica despues de los modulos que tocan order_line. -->
    <record id="view_order_form_trixo_adjust_lock_lines" model="ir.ui.view">
        <field name="name">sale.order.form.trixo.adjust.lock.lines</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_line']" position="before">
                <field name="trixo_lines_locked" invisible="1"/>
            </xpath>
            <xpath expr="//field[@name='order_line']" position="attributes">
                <attribute name="readonly" separator=" or " add="trixo_lines_locked"/>
            </xpath>
        </field>
    </record>

</odoo>
