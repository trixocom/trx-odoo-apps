<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Odoo 19: los grupos se agrupan por res.groups.privilege
         (res.groups.category_id fue removido en el rework de grupos). -->
    <record id="privilege_sale_adjust" model="res.groups.privilege">
        <field name="name">Ajuste de pedidos confirmados</field>
        <field name="sequence">96</field>
        <field name="category_id" ref="base.module_category_sales_sales"/>
    </record>

    <record id="group_sale_adjust" model="res.groups">
        <field name="name">Ajustar pedidos confirmados</field>
        <field name="privilege_id" ref="privilege_sale_adjust"/>
        <field name="comment">Puede abrir "Ajustar pedido" y el boton de cancelar pendiente sobre ordenes de venta confirmadas: devoluciones, notas de credito y cancelacion de cantidades pendientes.</field>
    </record>

    <!-- Privilegio aparte: los grupos de un mismo privilegio se eligen como
         opciones excluyentes en la ficha del usuario, y estos dos permisos son
         independientes entre si. -->
    <record id="privilege_native_return_refund" model="res.groups.privilege">
        <field name="name">Devolver y Nota de credito nativos</field>
        <field name="sequence">97</field>
        <field name="category_id" ref="base.module_category_sales_sales"/>
    </record>

    <record id="group_native_return_refund" model="res.groups">
        <field name="name">Ver "Devolver" y "Nota de credito" nativos</field>
        <field name="privilege_id" ref="privilege_native_return_refund"/>
        <field name="comment">Sigue viendo el boton "Devolver" en las transferencias de venta y el boton "Nota de credito" en las facturas de cliente. Sin este grupo esos botones quedan ocultos y las devoluciones y notas de credito de un pedido se hacen solo desde "Ajustar pedido". Por defecto no lo tiene nadie.</field>
    </record>
</odoo>
