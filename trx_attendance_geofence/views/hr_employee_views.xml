<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_employee_form_geofence" model="ir.ui.view">
        <field name="name">hr.employee.form.geofence</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="priority">120</field>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='managers']" position="inside">
                <field name="attendance_geofence_exempt"
                       groups="hr_attendance.group_hr_attendance_officer"/>
                <field name="attendance_excluded"
                       groups="hr_attendance.group_hr_attendance_officer"/>
                <field name="attendance_notify_channel_id"
                       groups="hr_attendance.group_hr_attendance_officer"
                       invisible="attendance_excluded"/>
            </xpath>
        </field>
    </record>
</odoo>
