<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Tags -->
        <record id="demo_tag_bug" model="helpdesk.tag">
            <field name="name">Bug</field>
            <field name="color">1</field>
        </record>
        <record id="demo_tag_howto" model="helpdesk.tag">
            <field name="name">How-to</field>
            <field name="color">4</field>
        </record>

        <!-- SLA policies on the Customer Care team -->
        <record id="demo_sla_high_8h" model="helpdesk.sla">
            <field name="name">High priority answered within 8h</field>
            <field name="team_id" ref="team_support"/>
            <field name="company_id" eval="False"/>
            <field name="priority">2</field>
            <field name="stage_id" ref="stage_in_progress"/>
            <field name="time">8.0</field>
        </record>
        <record id="demo_sla_resolve_48h" model="helpdesk.sla">
            <field name="name">Resolution within 48h</field>
            <field name="team_id" ref="team_support"/>
            <field name="company_id" eval="False"/>
            <field name="priority">0</field>
            <field name="stage_id" ref="stage_solved"/>
            <field name="time">48.0</field>
        </record>

        <!-- Sample tickets -->
        <record id="demo_ticket_1" model="helpdesk.ticket">
            <field name="name">Cannot log into the customer portal</field>
            <field name="team_id" ref="team_support"/>
            <field name="company_id" eval="False"/>
            <field name="stage_id" ref="stage_new"/>
            <field name="ticket_type_id" ref="type_issue"/>
            <field name="priority">2</field>
            <field name="partner_id" ref="base.res_partner_2"/>
            <field name="tag_ids" eval="[(4, ref('demo_tag_bug'))]"/>
            <field name="description"><![CDATA[<p>The customer reports a 403 error after entering valid credentials.</p>]]></field>
        </record>
        <record id="demo_ticket_2" model="helpdesk.ticket">
            <field name="name">How do I export my invoices to PDF?</field>
            <field name="team_id" ref="team_support"/>
            <field name="company_id" eval="False"/>
            <field name="stage_id" ref="stage_in_progress"/>
            <field name="ticket_type_id" ref="type_question"/>
            <field name="priority">1</field>
            <field name="partner_id" ref="base.res_partner_3"/>
            <field name="tag_ids" eval="[(4, ref('demo_tag_howto'))]"/>
        </record>
        <record id="demo_ticket_3" model="helpdesk.ticket">
            <field name="name">Production server is down - URGENT</field>
            <field name="team_id" ref="team_support"/>
            <field name="company_id" eval="False"/>
            <field name="stage_id" ref="stage_in_progress"/>
            <field name="ticket_type_id" ref="type_issue"/>
            <field name="priority">3</field>
            <field name="partner_id" ref="base.res_partner_4"/>
            <field name="tag_ids" eval="[(4, ref('demo_tag_bug'))]"/>
        </record>
        <record id="demo_ticket_4" model="helpdesk.ticket">
            <field name="name">Request for a new user account</field>
            <field name="team_id" ref="team_support"/>
            <field name="company_id" eval="False"/>
            <field name="stage_id" ref="stage_solved"/>
            <field name="ticket_type_id" ref="type_question"/>
            <field name="priority">0</field>
            <field name="partner_id" ref="base.res_partner_12"/>
        </record>

    </data>
</odoo>
