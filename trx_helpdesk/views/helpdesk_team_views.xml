<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ====================== DASHBOARD KANBAN ====================== -->
    <record id="helpdesk_team_view_kanban" model="ir.ui.view">
        <field name="name">helpdesk.team.kanban</field>
        <field name="model">helpdesk.team</field>
        <field name="arch" type="xml">
            <kanban class="o_helpdesk_team_kanban" create="1" group_create="0"
                    sample="1" highlight_color="color"
                    action="action_view_all_tickets" type="object">
                <field name="sequence" widget="handle"/>
                <field name="color"/>
                <field name="ticket_count"/>
                <field name="ticket_count_unassigned"/>
                <field name="ticket_count_urgent"/>
                <field name="ticket_count_sla_fail"/>
                <field name="ticket_count_my"/>
                <field name="ticket_closed_7days"/>
                <field name="sla_success_rate"/>
                <field name="use_sla"/>
                <templates>
                    <t t-name="menu">
                        <div class="container">
                            <div class="row">
                                <div class="col-6">
                                    <h5 role="menuitem" class="o_kanban_card_manage_title">
                                        <span>View</span>
                                    </h5>
                                    <div role="menuitem">
                                        <a name="action_view_all_tickets" type="object">All Tickets</a>
                                    </div>
                                    <div role="menuitem">
                                        <a name="action_view_my_tickets" type="object">My Tickets</a>
                                    </div>
                                </div>
                                <div class="col-6">
                                    <h5 role="menuitem" class="o_kanban_card_manage_title">
                                        <span>Configuration</span>
                                    </h5>
                                    <div role="menuitem">
                                        <a type="edit">Configure Team</a>
                                    </div>
                                </div>
                            </div>
                            <div class="o_kanban_card_manage_settings row">
                                <div role="menuitem" aria-haspopup="true" class="col-12">
                                    <field name="color" widget="kanban_color_picker"/>
                                </div>
                            </div>
                        </div>
                    </t>
                    <t t-name="card" class="px-3 py-2">
                        <field name="name" class="fw-bold fs-4"/>
                        <div class="row mt-3" t-if="!selection_mode">
                            <div class="col-5">
                                <button class="btn btn-primary o_trx_helpdesk_btn" name="action_view_open_tickets"
                                        type="object" context="{'default_team_id': id}">Tickets</button>
                            </div>
                            <div class="col-7">
                                <a name="action_view_my_tickets" type="object"
                                   title="My open tickets in this team."
                                   class="justify-content-between flex-nowrap d-inline-flex w-100 mb-1">
                                    <span>My Tickets</span>
                                    <field name="ticket_count_my" class="ms-3 text-nowrap fw-bold"/>
                                </a>
                                <a name="action_view_closed_7days" type="object"
                                   title="Number of tickets closed in the past 7 days."
                                   class="justify-content-between flex-nowrap d-inline-flex w-100 mb-1">
                                    <span>Tickets Closed</span>
                                    <field name="ticket_closed_7days" class="ms-3 text-nowrap fw-bold"/>
                                </a>
                                <a name="action_view_closed_7days" type="object"
                                   t-if="record.use_sla.raw_value and record.sla_success_rate.raw_value &gt;= 0"
                                   title="Percentage of tickets closed in the past 7 days whose SLA targets were all reached on time."
                                   class="justify-content-between flex-nowrap d-inline-flex w-100 mb-1">
                                    <span>SLA Success Rate</span>
                                    <span t-attf-class="ms-3 text-nowrap fw-bold {{ record.sla_success_rate.raw_value &lt; 50 ? 'text-danger' : record.sla_success_rate.raw_value &lt; 85 ? 'text-warning' : 'text-success' }}">
                                        <field name="sla_success_rate" widget="float" digits="[1, 1]"/> %
                                    </span>
                                </a>
                            </div>
                        </div>
                        <div class="row pt-4 mt-auto o_trx_helpdesk_counters" t-if="!selection_mode">
                            <a name="action_view_open_tickets" type="object"
                               class="d-flex flex-column align-items-center col">
                                <field name="ticket_count" class="fw-bold fs-3"/>
                                <span class="text-muted text-nowrap">Open</span>
                            </a>
                            <a name="action_view_unassigned" type="object"
                               class="d-flex flex-column align-items-center col border-start">
                                <span t-attf-class="fw-bold fs-3 {{ record.ticket_count_unassigned.raw_value &gt; 0 ? 'text-warning' : '' }}">
                                    <field name="ticket_count_unassigned"/>
                                </span>
                                <span class="text-muted text-nowrap">Unassigned</span>
                            </a>
                            <a name="action_view_urgent" type="object"
                               class="d-flex flex-column align-items-center col border-start">
                                <span t-attf-class="fw-bold fs-3 {{ record.ticket_count_urgent.raw_value &gt; 0 ? 'text-danger' : '' }}">
                                    <field name="ticket_count_urgent"/>
                                </span>
                                <span class="text-muted text-nowrap">Urgent</span>
                            </a>
                            <a name="action_view_sla_fail" type="object" t-if="record.use_sla.raw_value"
                               title="Number of open tickets with at least one SLA failed."
                               class="d-flex flex-column align-items-center col border-start">
                                <span t-attf-class="fw-bold fs-3 {{ record.ticket_count_sla_fail.raw_value &gt; 0 ? 'text-danger' : '' }}">
                                    <field name="ticket_count_sla_fail"/>
                                </span>
                                <span class="text-muted text-nowrap">SLA Failed</span>
                            </a>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- ====================== LIST ====================== -->
    <record id="helpdesk_team_view_list" model="ir.ui.view">
        <field name="name">helpdesk.team.list</field>
        <field name="model">helpdesk.team</field>
        <field name="arch" type="xml">
            <list string="Teams">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="assign_method"/>
                <field name="member_ids" widget="many2many_tags" optional="show"/>
                <field name="use_sla" optional="show"/>
                <field name="ticket_count" string="Open"/>
            </list>
        </field>
    </record>

    <!-- ====================== FORM ====================== -->
    <record id="helpdesk_team_view_form" model="ir.ui.view">
        <field name="name">helpdesk.team.form</field>
        <field name="model">helpdesk.team</field>
        <field name="arch" type="xml">
            <form string="Team">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_all_tickets" type="object"
                                class="oe_stat_button" icon="fa-life-ring">
                            <field name="ticket_count" widget="statinfo" string="Open"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Customer Care"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="assign_method"/>
                            <field name="member_ids" widget="many2many_tags"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="use_sla"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Stages" name="stages">
                            <field name="stage_ids" widget="many2many_tags"/>
                        </page>
                        <page string="SLA Policies" name="sla" invisible="not use_sla">
                            <field name="sla_ids">
                                <list editable="bottom">
                                    <field name="name"/>
                                    <field name="priority" widget="priority"/>
                                    <field name="stage_id"/>
                                    <field name="time"/>
                                </list>
                            </field>
                        </page>
                        <page string="Description" name="description">
                            <field name="description"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="helpdesk_team_action" model="ir.actions.act_window">
        <field name="name">Helpdesk Teams</field>
        <field name="res_model">helpdesk.team</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a Helpdesk team
            </p><p>
                Organize your support staff into teams to handle tickets.
            </p>
        </field>
    </record>

    <record id="helpdesk_team_config_action" model="ir.actions.act_window">
        <field name="name">Teams</field>
        <field name="res_model">helpdesk.team</field>
        <field name="view_mode">list,form,kanban</field>
    </record>

</odoo>
