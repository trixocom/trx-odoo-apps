<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="helpdesk_sla_view_list" model="ir.ui.view">
        <field name="name">helpdesk.sla.list</field>
        <field name="model">helpdesk.sla</field>
        <field name="arch" type="xml">
            <list string="SLA Policies">
                <field name="name"/>
                <field name="team_id"/>
                <field name="priority" widget="priority"/>
                <field name="stage_id"/>
                <field name="time"/>
            </list>
        </field>
    </record>

    <record id="helpdesk_sla_view_form" model="ir.ui.view">
        <field name="name">helpdesk.sla.form</field>
        <field name="model">helpdesk.sla</field>
        <field name="arch" type="xml">
            <form string="SLA Policy">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Urgent tickets solved within 8 hours"/></h1>
                    </div>
                    <group>
                        <group string="Applies to">
                            <field name="team_id"/>
                            <field name="priority" widget="priority"/>
                            <field name="ticket_type_ids" widget="many2many_tags"
                                   placeholder="All types"/>
                        </group>
                        <group string="Target">
                            <field name="stage_id"/>
                            <field name="time"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <group string="Description">
                        <field name="description" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="helpdesk_sla_action" model="ir.actions.act_window">
        <field name="name">SLA Policies</field>
        <field name="res_model">helpdesk.sla</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
