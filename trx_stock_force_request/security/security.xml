<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <record model="res.groups.privilege" id="privilege_force_request">
            <field name="name">Forzado de stock</field>
            <field name="category_id" ref="base.module_category_supply_chain"/>
            <field name="sequence">60</field>
        </record>

        <record id="group_force_approver" model="res.groups">
            <field name="name">Aprobar forzado de stock</field>
            <field name="privilege_id" ref="privilege_force_request"/>
            <field name="comment">Recibe las solicitudes de forzado de stock y puede aprobarlas o rechazarlas. Nadie mas puede forzar disponibilidad.</field>
        </record>

        <!-- El que pide ve las suyas; el aprobador ve todas. -->
        <record id="rule_force_request_own" model="ir.rule">
            <field name="name">Solicitudes de forzado: propias</field>
            <field name="model_id" ref="model_stock_force_request"/>
            <field name="domain_force">[('requester_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('stock.group_stock_user'))]"/>
        </record>
        <record id="rule_force_request_approver" model="ir.rule">
            <field name="name">Solicitudes de forzado: aprobadores</field>
            <field name="model_id" ref="model_stock_force_request"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_force_approver')), (4, ref('stock.group_stock_manager'))]"/>
        </record>

    </data>
</odoo>
