<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_stock_force_request_form" model="ir.ui.view">
        <field name="name">stock.force.request.form</field>
        <field name="model">stock.force.request</field>
        <field name="arch" type="xml">
            <form string="Solicitud de forzado de stock">
                <header>
                    <button name="action_submit" string="Enviar solicitud" type="object"
                            class="btn-primary" invisible="state != 'draft'"
                            help="Le llega al aprobador por Odoo (pop-up, campanita, celular) y por WhatsApp si esta configurado."/>
                    <button name="action_approve" string="Aprobar y forzar stock" type="object"
                            class="btn-primary" invisible="state != 'pending' or not is_approver"
                            groups="trx_stock_force_request.group_force_approver"
                            confirm="El despacho va a quedar disponible aunque el stock del sistema quede negativo. ¿Aprobar?"/>
                    <button name="action_reject" string="Rechazar" type="object"
                            class="btn-secondary" invisible="state != 'pending' or not is_approver"
                            groups="trx_stock_force_request.group_force_approver"/>
                    <button name="action_cancel" string="Cancelar solicitud" type="object"
                            invisible="state not in ('draft', 'pending')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,pending,approved"/>
                </header>
                <sheet>
                    <field name="is_approver" invisible="1"/>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Despacho">
                            <field name="picking_id" options="{'no_create': True, 'no_open': False}"/>
                            <field name="origin"/>
                            <field name="partner_ref_id"/>
                            <field name="picking_state"/>
                        </group>
                        <group string="Quien">
                            <field name="requester_id"/>
                            <field name="approver_id"/>
                            <field name="request_date" invisible="not request_date"/>
                            <field name="decision_date" invisible="not decision_date"/>
                            <field name="whatsapp_info" invisible="not whatsapp_info"/>
                        </group>
                    </group>
                    <group string="Motivo (obligatorio)">
                        <field name="reason" nolabel="1" readonly="state != 'draft'"
                               placeholder="Ej.: la mercaderia esta en el deposito, entro hoy y no se registro la recepcion todavia."/>
                    </group>
                    <group string="Foto (opcional)">
                        <field name="photo" widget="image" nolabel="1" readonly="state != 'draft'"
                               options="{'size': [0, 320], 'accepted_file_extensions': 'image/*'}"/>
                    </group>
                    <group string="Que falta">
                        <field name="line_ids" nolabel="1" readonly="1">
                            <list create="0" delete="0">
                                <field name="product_id"/>
                                <field name="qty_demand"/>
                                <field name="qty_reserved"/>
                                <field name="qty_missing" decoration-danger="1"/>
                                <field name="product_uom_id"/>
                                <field name="qty_on_hand"/>
                                <field name="qty_free"/>
                                <field name="product_base_uom_id"/>
                            </list>
                        </field>
                    </group>
                    <group string="Respuesta del aprobador" invisible="state == 'draft'">
                        <field name="decision_note" nolabel="1" readonly="state != 'pending' or not is_approver"
                               placeholder="Obligatoria para rechazar; opcional para aprobar."/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_stock_force_request_list" model="ir.ui.view">
        <field name="name">stock.force.request.list</field>
        <field name="model">stock.force.request</field>
        <field name="arch" type="xml">
            <list string="Solicitudes de forzado de stock" create="0"
                  decoration-warning="state == 'pending'" decoration-success="state == 'approved'"
                  decoration-muted="state in ('rejected', 'cancelled')">
                <field name="name"/>
                <field name="request_date"/>
                <field name="picking_id"/>
                <field name="origin"/>
                <field name="partner_ref_id"/>
                <field name="requester_id" widget="many2one_avatar_user"/>
                <field name="approver_id" widget="many2one_avatar_user"/>
                <field name="state" widget="badge"/>
                <field name="decision_date" optional="hide"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_stock_force_request_search" model="ir.ui.view">
        <field name="name">stock.force.request.search</field>
        <field name="model">stock.force.request</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="picking_id"/>
                <field name="origin"/>
                <field name="requester_id"/>
                <field name="approver_id"/>
                <filter name="pending" string="Pendientes" domain="[('state', '=', 'pending')]"/>
                <filter name="mine" string="Me esperan a mi"
                        domain="[('state', '=', 'pending'), '|', ('approver_id', '=', uid), ('approver_id', '=', False)]"/>
                <filter name="approved" string="Aprobadas" domain="[('state', '=', 'approved')]"/>
                <filter name="rejected" string="Rechazadas" domain="[('state', '=', 'rejected')]"/>
                <separator/>
                <filter name="group_state" string="Estado" context="{'group_by': 'state'}"/>
                <filter name="group_requester" string="Solicita" context="{'group_by': 'requester_id'}"/>
                <filter name="group_date" string="Fecha" context="{'group_by': 'request_date:day'}"/>
            </search>
        </field>
    </record>

    <record id="action_stock_force_request" model="ir.actions.act_window">
        <field name="name">Solicitudes de forzado de stock</field>
        <field name="res_model">stock.force.request</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_stock_force_request_search"/>
        <field name="context">{'search_default_pending': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No hay solicitudes de forzado de stock</p>
            <p>Se crean desde el despacho, con el boton "Solicitar forzar stock", cuando falta stock en el sistema.</p>
        </field>
    </record>

    <menuitem id="menu_stock_force_request" name="Solicitudes de forzado"
              parent="stock.menu_stock_warehouse_mgmt" action="action_stock_force_request"
              sequence="90"/>

</odoo>
