<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form_trx_force" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.trx.force.request</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="stock.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='warehouse_setting_container']" position="inside">
                <setting id="trx_block_negative_stock" string="Bloquear stock negativo"
                         help="Ningun movimiento que sale de una ubicacion interna puede dejar el stock en negativo, por ningun camino (formulario, cantidades a mano, codigo de barras, transferencias, desechos). Solo se exceptua el despacho con solicitud de forzado aprobada.">
                    <field name="trx_block_negative_stock"/>
                </setting>
            </xpath>
        </field>
    </record>

</odoo>
