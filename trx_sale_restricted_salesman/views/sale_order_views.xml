<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Lista de precios: solo lectura y sin poder abrirla -->
    <record id="view_order_form_vendedor_restringido" model="ir.ui.view">
        <field name="name">sale.order.form.vendedor.restringido</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='pricelist_id']" position="before">
                <field name="trx_vendedor_restringido" invisible="1"/>
            </xpath>
            <xpath expr="//field[@name='pricelist_id']" position="attributes">
                <attribute name="readonly">trx_vendedor_restringido or state in ('cancel', 'sale')</attribute>
                <attribute name="options">{'no_open': True, 'no_create': True}</attribute>
            </xpath>
        </field>
    </record>
</odoo>
