<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_no_create_product" model="ir.ui.view">
        <field name="name">sale.order.form.no.create.product</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <!-- Campo visible por defecto en la columna "Producto" -->
            <xpath expr="//field[@name='order_line']//field[@name='product_template_id']" position="attributes">
                <attribute name="options">{'show_label_warning': True, 'no_create': True}</attribute>
            </xpath>
            <!-- Campo de variante (columna opcional) -->
            <xpath expr="//field[@name='order_line']//field[@name='product_id'][@widget='sol_product_many2one']" position="attributes">
                <attribute name="options">{'show_label_warning': True, 'no_create': True}</attribute>
            </xpath>
        </field>
    </record>
</odoo>
