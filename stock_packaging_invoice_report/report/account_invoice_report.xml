<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_invoice_document_inherit_packaging" inherit_id="account.report_invoice_document">
        <!-- Agregar header "Cantidad de Embalaje" después de columna Cantidad -->
        <xpath expr="//table[@name='invoice_line_table']/thead/tr/th[@name='th_quantity']" position="after">
            <th name="th_packaging_quantity" class="text-end">Cantidad de Embalaje</th>
        </xpath>

        <!-- Agregar dato de cantidad de embalaje después de cantidad -->
        <xpath expr="//table[@name='invoice_line_table']/tbody//tr//td[@name='td_quantity']" position="after">
            <td name="td_packaging_quantity" class="text-end">
                <span t-field="line.packaging_quantity_invoice"/>
            </td>
        </xpath>
    </template>

    <!-- Mostrar Total Bultos grande en el encabezado del reporte de factura estándar.
         Nota: l10n_ar.report_invoice_document hereda (primary) de esta plantilla,
         asi que la factura AR tambien lo muestra, igual que en 18. -->
    <template id="report_invoice_document_inherit_total_bultos" inherit_id="account.report_invoice_document" priority="99">
        <xpath expr="//div[@id='informations']" position="before">
            <div class="mt-2 mb-3" t-if="o.total_bultos" style="font-size: 1.5rem; font-weight: bold;">
                <span>Total Bultos: </span>
                <span t-field="o.total_bultos"/>
            </div>
        </xpath>
    </template>

    <!-- v19: removidas las 2 herencias de plantillas studio_customization.*
         (copias de Odoo Studio EE que solo existen en la DB 18 de prod).
         Se reintroducen con el workstream Studio->modulos. -->
</odoo>
